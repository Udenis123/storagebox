# Copy to .env.production on the server and fill in every value.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

IMAGE_TAG=latest
API_HOST_PORT=4200

NODE_ENV=production
# Public URLs (what browsers and share links use)
PUBLIC_URL=https://storagebox.urbinaryhub.rw
APP_URL=https://storagebox.urbinaryhub.rw
CORS_ORIGINS=https://storagebox.urbinaryhub.rw

# Secrets — generate long random strings
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
SIGNING_SECRET=

# Postgres (compose overrides DATABASE_URL to use the postgres service)
POSTGRES_DB=storagebox
POSTGRES_USER=storagebox
POSTGRES_PASSWORD=

# Object storage credentials (RustFS + API)
S3_BUCKET=storagebox
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
RUSTFS_IMAGE_TAG=latest

# Limits
MAX_UPLOAD_MB=5120
UPLOAD_TIMEOUT_MINUTES=60
DEFAULT_QUOTA_GB=5
RATE_LIMIT_PER_MINUTE=300

# First admin (created on boot if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=StorageBox Admin
