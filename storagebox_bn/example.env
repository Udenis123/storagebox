NODE_ENV=development
PORT=4200
# Comma-separated origins allowed by CORS (the storagebox_fn URL)
CORS_ORIGINS=http://localhost:3200
# Public base URL of this API — used to build delivery links (/f/...)
PUBLIC_URL=http://localhost:4200

DATABASE_URL=postgresql://storagebox:storagebox@localhost:5435/storagebox
VALKEY_URL=redis://localhost:6381

# Dashboard sessions
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# HMAC secret for signed (private) delivery URLs — keep it stable, rotating it invalidates links
SIGNING_SECRET=change-me-too

# S3-compatible storage (RustFS)
S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_BUCKET=storagebox
S3_ACCESS_KEY=storagebox_rustfs
S3_SECRET_KEY=storagebox_rustfs_secret

# Limits
MAX_UPLOAD_MB=100
DEFAULT_QUOTA_GB=5
RATE_LIMIT_PER_MINUTE=300

# Default platform administrator (created/restored on startup). Sign-ups wait for this admin to approve them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=StorageBox Admin
